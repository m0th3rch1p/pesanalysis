{
  "name": "@yako/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript, zero native deps. Runs in Node (tests/evals) AND in the Expo app (Hermes). No LLM here: deterministic spine.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "synth": "tsx src/synth/cli.ts",
    "coverage:private": "tsx src/sms/coverage-cli.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  }
}
